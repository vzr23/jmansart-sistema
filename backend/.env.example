# ── Servidor ────────────────────────────────────
PORT=3001

# CORS: OBRIGATÓRIO. O servidor recusa iniciar sem esta variável.
# Informe a origem exata do frontend, sem barra no final. "*" só é aceito fora de produção.
# Produção: CORS_ORIGIN=https://jmansart-sistema.vercel.app
CORS_ORIGIN=https://jmansart-sistema.vercel.app

# Quantos proxies ficam na frente do backend (Railway = 1). Usado para identificar o IP nos limites de login.
TRUST_PROXY_HOPS=1

# ── Google Sheets (Banco de Dados) ───────────────
SPREADSHEET_ID=15BLBHc0watZaGCzhzItPDTRYmWa4UUoxAaGorIXUunQ
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# ── Autenticação: Usuário e Senha ────────────────
AUTH_USER=seu_usuario
AUTH_PASS=sua_senha_segura

# ── Autenticação: JWT ────────────────────────────
AUTH_JWT_SECRET=sua_chave_secreta_muito_segura

# ── Autenticação: E-mail para 2FA (Nodemailer) ───
AUTH_EMAIL=seu_email@example.com
EMAIL_USER=seu_email_gmail@gmail.com
EMAIL_PASS=seu_app_password_gmail

# ── Contrato (Autorização para Venda) ───────────
# Marca "MINUTA" no PDF enquanto o texto jurídico não for aprovado. Use false para remover.
CONTRATO_MARCA_MINUTA=true
